– OPTIMIZED COMPONENT DATA PROCESSING
– ========================================

INSERT INTO #M4 (aoiid, landunit, mukey, mapunit_acres, cokey, compname,
comppct_r, majcompflag, mu_pct_sum, major_mu_pct_sum, drainagecl)
SELECT
M2.aoiid, M2.landunit, M2.mukey, M2.mapunit_acres,
CO.cokey, CO.compname, CO.comppct_r, CO.majcompflag,
SUM(CO.comppct_r) OVER (PARTITION BY M2.aoiid, M2.landunit, M2.mukey) AS mu_pct_sum,
SUM(CASE WHEN CO.majcompflag = ‘Yes’ THEN CO.comppct_r ELSE 0 END)
OVER (PARTITION BY M2.aoiid, M2.landunit, M2.mukey) AS major_mu_pct_sum,
CO.drainagecl
FROM #M2 M2
INNER JOIN component CO ON CO.mukey = M2.mukey;

– ========================================
– CONSOLIDATED METADATA COLLECTION
– ========================================

– Single query for metadata instead of multiple inserts
WITH MetadataCollection AS (
SELECT DISTINCT
AM.landunit,
SC.areasymbol + ’ ’ + CONVERT(VARCHAR(32), SC.saverest, 120) AS datestamp
FROM #M4 AM
INNER JOIN mapunit MU ON AM.mukey = MU.mukey
INNER JOIN legend LG ON MU.lkey = LG.lkey
INNER JOIN sacatalog SC ON LG.areasymbol = SC.areasymbol
),
ConsolidatedMetadata AS (
SELECT
landunit,
STRING_AGG(datestamp, ’ | ’) AS soils_metadata
FROM MetadataCollection
GROUP BY landunit
)
SELECT landunit, soils_metadata
INTO #LandunitMetadata
FROM ConsolidatedMetadata;

