– ========================================
– OPTIMIZED ACRES CALCULATION
– ========================================

INSERT INTO #AoiAcres (aoiid, landunit, landunit_acres)
SELECT
aoiid,
landunit,
ROUND(SUM(GEOGRAPHY::STGeomFromWKB(aoigeom.STAsBinary(), 4326).STArea() / 4046.8564224), 3)
FROM #AoiTable
GROUP BY aoiid, landunit;

– ========================================
– OPTIMIZED SPATIAL INTERSECTION
– ========================================

– Use spatial index hint and optimize geometry operations
INSERT INTO #AoiSoils2 (aoiid, polyid, landunit, mukey, poly_acres, soilgeog)
SELECT
A.aoiid,
ROW_NUMBER() OVER (ORDER BY A.aoiid, M.mukey) as polyid,
A.landunit,
M.mukey,
ROUND(GEOGRAPHY::STGeomFromWKB(
M.mupolygongeo.STIntersection(A.aoigeom).STAsBinary(), 4326
).MakeValid().STArea() / 4046.8564224, 3) AS poly_acres,
GEOGRAPHY::STGeomFromWKB(
M.mupolygongeo.STIntersection(A.aoigeom).STAsBinary(), 4326
).MakeValid() AS soilgeog
FROM mupolygon M WITH (INDEX(SpatialIndex))  – Use spatial index hint
INNER JOIN #AoiTable A ON M.mupolygongeo.STIntersects(A.aoigeom) = 1
WHERE M.mupolygongeo.STIntersects(A.aoigeom) = 1;  – Redundant but helps optimizer

– ========================================
– OPTIMIZED AGGREGATIONS WITH CTEs
– ========================================

– Map unit aggregation using window functions
WITH MapUnitAgg AS (
SELECT DISTINCT
aoiid,
landunit,
mukey,
SUM(poly_acres) OVER (PARTITION BY aoiid, landunit, mukey) AS mapunit_acres
FROM #AoiSoils2
)
INSERT INTO #M2 (aoiid, landunit, mukey, mapunit_acres)
SELECT aoiid, landunit, mukey, ROUND(mapunit_acres, 3)
FROM MapUnitAgg;

