– ========================================
– OPTIMIZED SOIL CALCULATIONS
– ========================================

– Consolidated SOC calculation with optimized horizon processing
WITH OptimizedSOC AS (
SELECT
M4.aoiid, M4.landunit, M4.mukey, M4.mapunit_acres,
M4.cokey, M4.compname, M4.comppct_r, M4.majcompflag,
CH.hzname, CH.hzdept_r, CH.hzdepb_r,
COALESCE(CH.om_r, CASE WHEN CT.texture LIKE ‘%PEAT%’ THEN 35 ELSE NULL END) AS om_r,
COALESCE(CH.dbthirdbar_r, CASE WHEN CT.texture LIKE ‘%PEAT%’ THEN 0.25 ELSE NULL END) AS dbthirdbar_r,
COALESCE(CF.total_fragvol, 0) AS fragvol,
CT.texture,
– Optimized depth range calculations
CASE WHEN CH.hzdept_r < 150 THEN CH.hzdept_r ELSE 0 END AS top_0_150,
CASE WHEN CH.hzdepb_r <= 150 THEN CH.hzdepb_r
WHEN CH.hzdepb_r > 150 AND CH.hzdept_r < 150 THEN 150
ELSE 0 END AS bot_0_150,
– Additional depth ranges for other calculations…
M4.mu_pct_sum
FROM #M4 M4
INNER JOIN component CO ON M4.cokey = CO.cokey AND M4.majcompflag = ‘Yes’
INNER JOIN chorizon CH ON CO.cokey = CH.cokey
LEFT JOIN chtexturegrp CT ON CH.chkey = CT.chkey AND CT.rvindicator = ‘yes’
LEFT JOIN (
SELECT chkey, SUM(COALESCE(fragvol_r, 0)) AS total_fragvol
FROM chfrags GROUP BY chkey
) CF ON CH.chkey = CF.chkey
WHERE CH.hzdept_r IS NOT NULL
AND CH.om_r IS NOT NULL
AND CH.dbthirdbar_r IS NOT NULL
),
SOCCalculations AS (
SELECT
aoiid, landunit, mukey, cokey,
SUM(((bot_0_150 - top_0_150) * (om_r / 1.724) * dbthirdbar_r / 100.0) *
((100.0 - fragvol) / 100.0)) AS soc_0_150,
– Additional SOC calculations…
(comppct_r * 1.0 / NULLIF(mu_pct_sum, 0)) AS adj_comp_pct
FROM OptimizedSOC
GROUP BY aoiid, landunit, mukey, cokey, comppct_r, mu_pct_sum
)
SELECT
aoiid, landunit,
SUM((mapunit_acres / landunit_acres) * soc_0_150 * adj_comp_pct * 100) AS socstock_weighted_avg
INTO #SOC6
FROM SOCCalculations SC
INNER JOIN #AoiAcres AA ON SC.aoiid = AA.aoiid
INNER JOIN #M2 M2 ON SC.aoiid = M2.aoiid AND SC.mukey = M2.mukey
GROUP BY SC.aoiid, SC.landunit, AA.landunit_acres;

