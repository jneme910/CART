– ========================================
– OPTIMIZED TABLE CREATION WITH BETTER INDEXING
– ========================================

– AOI table with spatial index
CREATE TABLE #AoiTable (
aoiid INT IDENTITY(1,1) PRIMARY KEY,
landunit NVARCHAR(20) NOT NULL,
aoigeom GEOMETRY NOT NULL,
INDEX IX_AoiTable_Spatial SPATIAL (aoigeom)
);

– Pre-calculated acres table with clustered index
CREATE TABLE #AoiAcres (
aoiid INT NOT NULL,
landunit NVARCHAR(20) NOT NULL,
landunit_acres FLOAT NOT NULL,
PRIMARY KEY CLUSTERED (aoiid),
INDEX IX_AoiAcres_Landunit NONCLUSTERED (landunit)
);

– Optimized soil intersection table
CREATE TABLE #AoiSoils2 (
aoiid INT NOT NULL,
polyid INT NOT NULL,
landunit NVARCHAR(20) NOT NULL,
mukey INT NOT NULL,
poly_acres FLOAT NOT NULL,
soilgeog GEOGRAPHY,
PRIMARY KEY CLUSTERED (aoiid, polyid),
INDEX IX_AoiSoils2_Mukey NONCLUSTERED (mukey),
INDEX IX_AoiSoils2_Landunit NONCLUSTERED (landunit)
);

– Map unit aggregation with covering index
CREATE TABLE #M2 (
aoiid INT NOT NULL,
landunit NVARCHAR(20) NOT NULL,
mukey INT NOT NULL,
mapunit_acres FLOAT NOT NULL,
PRIMARY KEY CLUSTERED (aoiid, landunit, mukey),
INDEX IX_M2_Covering NONCLUSTERED (mukey) INCLUDE (mapunit_acres)
);

– Component data with optimized indexing
CREATE TABLE #M4 (
aoiid INT NOT NULL,
landunit NVARCHAR(20) NOT NULL,
mukey INT NOT NULL,
mapunit_acres FLOAT NOT NULL,
cokey INT NOT NULL,
compname NVARCHAR(60),
comppct_r INT,
majcompflag NVARCHAR(3),
mu_pct_sum INT,
major_mu_pct_sum INT,
drainagecl NVARCHAR(254),
PRIMARY KEY CLUSTERED (aoiid, landunit, mukey, cokey),
INDEX IX_M4_Cokey NONCLUSTERED (cokey),
INDEX IX_M4_Major NONCLUSTERED (majcompflag) WHERE majcompflag = ‘Yes’
);

