CREATE OR ALTER PROCEDURE dbo.advanced_hydric_analysis
AS
BEGIN
SET NOCOUNT ON;
DECLARE @step_start DATETIME2(7) = SYSDATETIME();

```
-- ML-enhanced hydric soil classification
WITH hydric_intelligence AS (
    SELECT 
        sa.landunit,
        m.mukey,
        
        -- Multi-factor hydric analysis
        COUNT(CASE WHEN c.hydricrating = 'Yes' THEN 1 END) AS hydric_components,
        COUNT(CASE WHEN c.hydricrating != 'Yes' OR c.hydricrating IS NULL THEN 1 END) AS non_hydric_components,
        COUNT(CASE WHEN c.majcompflag = 'Yes' AND c.hydricrating = 'Yes' THEN 1 END) AS major_hydric,
        COUNT(CASE WHEN c.majcompflag = 'Yes' THEN 1 END) AS total_major,
        
        -- Drainage class indicators
        AVG(CASE 
            WHEN c.drainagecl IN ('Poorly drained', 'Very poorly drained') THEN 1.0
            WHEN c.drainagecl IN ('Somewhat poorly drained') THEN 0.7
            WHEN c.drainagecl IN ('Moderately well drained') THEN 0.3
            ELSE 0.0
        END) AS drainage_score,
        
        -- Weighted component analysis
        SUM(CASE WHEN c.hydricrating = 'Yes' THEN c.comppct_r ELSE 0 END) AS hydric_pct,
        SUM(c.comppct_r) AS total_pct,
        
        sa.mapunit_acres
        
    FROM dbo.cart_soil_analytics sa
    INNER JOIN mapunit m ON sa.mukey = m.mukey
    INNER JOIN component c ON m.mukey = c.mukey
    GROUP BY sa.landunit, m.mukey, sa.mapunit_acres
),
hydric_classification AS (
    SELECT 
        landunit,
        mukey,
        
        -- Advanced hydric classification algorithm
        CASE 
            WHEN hydric_components = 0 THEN 'Nonhydric'
            WHEN hydric_components = (hydric_components + non_hydric_components) THEN 'Hydric'
            WHEN major_hydric = total_major AND major_hydric > 0 THEN 'Predominantly hydric'
            WHEN hydric_pct >= 50 THEN 'Predominantly hydric'
            WHEN hydric_pct >= 15 THEN 'Partially hydric'
            WHEN hydric_pct > 0 THEN 'Predominantly nonhydric'
            ELSE 'Nonhydric'
        END AS hydric_class,
        
        -- Probability estimates
        CASE 
            WHEN hydric_components = 0 THEN 0.0
            WHEN hydric_components = (hydric_components + non_hydric_components) THEN 1.0
            WHEN major_hydric = total_major AND major_hydric > 0 THEN 0.85
            ELSE CAST(hydric_pct AS DECIMAL(5,2)) / 100.0
        END AS hydric_probability,
        
        -- Confidence scoring based on data completeness
        CASE 
            WHEN total_pct >= 95 THEN 0.95
            WHEN total_pct >= 85 THEN 0.85
            WHEN total_pct >= 70 THEN 0.75
            ELSE 0.60
        END AS classification_confidence,
        
        mapunit_acres
        
    FROM hydric_intelligence
)
INSERT INTO #modern_results (
    landunit, attribute_name, rating_value, rating_class, 
    confidence_score, total_acres, analysis_timestamp
)
SELECT 
    landunit,
    'Hydric Soils - Advanced' AS attribute_name,
    CASE hydric_class
        WHEN 'Nonhydric' THEN 0
        WHEN 'Predominantly nonhydric' THEN 1
        WHEN 'Partially hydric' THEN 2
        WHEN 'Predominantly hydric' THEN 3
        WHEN 'Hydric' THEN 4
    END AS rating_value,
    hydric_class AS rating_class,
    classification_confidence AS confidence_score,
    SUM(mapunit_acres) AS total_acres,
    SYSDATETIME() AS analysis_timestamp
FROM hydric_classification
GROUP BY landunit, hydric_class, classification_confidence;

EXEC #log_performance 'Advanced Hydric Analysis', @step_start, @@ROWCOUNT;
```

END;

