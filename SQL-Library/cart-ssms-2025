CREATE OR ALTER PROCEDURE dbo.intelligent_interpretation_engine
AS
BEGIN
SET NOCOUNT ON;
DECLARE @step_start DATETIME2(7) = SYSDATETIME();

```
-- Advanced interpretation with fuzzy logic and confidence scoring
WITH interpretation_matrix AS (
    SELECT 
        sa.landunit,
        
        -- SOC interpretation with graduated confidence
        CASE 
            WHEN JSON_VALUE(soil_properties, '$.soc_0_30') IS NULL THEN 
                JSON_OBJECT('rating': 7, 'class': 'Not rated', 'confidence': 0.0)
            WHEN CAST(JSON_VALUE(soil_properties, '$.soc_0_30') AS DECIMAL(10,3)) = 0 THEN 
                JSON_OBJECT('rating': 1, 'class': 'None', 'confidence': 0.9)
            WHEN CAST(JSON_VALUE(soil_properties, '$.soc_0_30') AS DECIMAL(10,3)) < 10 THEN 
                JSON_OBJECT('rating': 2, 'class': 'Very low', 'confidence': 0.85)
            WHEN CAST(JSON_VALUE(soil_properties, '$.soc_0_30') AS DECIMAL(10,3)) < 25 THEN 
                JSON_OBJECT('rating': 3, 'class': 'Low', 'confidence': 0.8)
            WHEN CAST(JSON_VALUE(soil_properties, '$.soc_0_30') AS DECIMAL(10,3)) < 50 THEN 
                JSON_OBJECT('rating': 4, 'class': 'Moderate', 'confidence': 0.8)
            WHEN CAST(JSON_VALUE(soil_properties, '$.soc_0_30') AS DECIMAL(10,3)) < 100 THEN 
                JSON_OBJECT('rating': 5, 'class': 'Moderately High', 'confidence': 0.75)
            ELSE JSON_OBJECT('rating': 6, 'class': 'High', 'confidence': 0.7)
        END AS soc_interpretation,
        
        -- Aggregate stability with uncertainty quantification
        CASE 
            WHEN JSON_VALUE(soil_properties, '$.aggregate_stability') IS NULL THEN 
                JSON_OBJECT('rating': 5, 'class': 'Not Rated', 'confidence': 0.0)
            WHEN CAST(JSON_VALUE(soil_properties, '$.aggregate_stability') AS DECIMAL(5,2)) < 25 THEN 
                JSON_OBJECT('rating': 1, 'class': 'Low', 'confidence': 0.9)
            WHEN CAST(JSON_VALUE(soil_properties, '$.aggregate_stability') AS DECIMAL(5,2)) < 50 THEN 
                JSON_OBJECT('rating': 2, 'class': 'Moderate', 'confidence': 0.85)
            WHEN CAST(JSON_VALUE(soil_properties, '$.aggregate_stability') AS DECIMAL(5,2)) < 75 THEN 
                JSON_OBJECT('rating': 3, 'class': 'Moderately High', 'confidence': 0.8)
            ELSE JSON_OBJECT('rating': 4, 'class': 'High', 'confidence': 0.75)
        END AS aggregate_interpretation,
        
        -- Weighted area calculations
        SUM(mapunit_acres) AS total_acres,
        
        -- Advanced confidence metrics
        AVG(CAST(JSON_VALUE(soil_properties, '$.confidence_level') AS DECIMAL(3,2))) AS avg_confidence
        
    FROM dbo.cart_soil_analytics sa
    WHERE soil_properties IS NOT NULL
    GROUP BY sa.landunit
)
SELECT 
    landunit,
    'Soil Organic Carbon Stock' AS attribute_name,
    JSON_VALUE(soc_interpretation, '$.rating') AS rating_value,
    JSON_VALUE(soc_interpretation, '$.class') AS rating_class,
    JSON_VALUE(soc_interpretation, '$.confidence') AS confidence_score,
    total_acres,
    SYSDATETIME() AS analysis_timestamp
INTO #modern_results
FROM interpretation_matrix

UNION ALL

SELECT 
    landunit,
    'Aggregate Stability' AS attribute_name,
    JSON_VALUE(aggregate_interpretation, '$.rating') AS rating_value,
    JSON_VALUE(aggregate_interpretation, '$.class') AS rating_class,
    JSON_VALUE(aggregate_interpretation, '$.confidence') AS confidence_score,
    total_acres,
    SYSDATETIME() AS analysis_timestamp
FROM interpretation_matrix;

EXEC #log_performance 'Intelligent Interpretation Engine', @step_start, @@ROWCOUNT;
```

END;

